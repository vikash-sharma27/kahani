# ==============================================================================
# KahaniNest / StoryNest Environment Variables
# ==============================================================================

# 1. DATABASE CONFIGURATION (Neon / Supabase Serverless Postgres)
# Create a free project at https://neon.tech or https://supabase.com
# Use the pooled connection string (port 6543 or pgbouncer) for DATABASE_URL with sslmode=require
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# Use the direct unpooled connection string (port 5432) for DIRECT_URL (Prisma migrations)
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. AUTHENTICATION & SECRETS (Generate with: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-random-32-character-secret-key-123456"
AGE_GATE_SECRET="replace-with-another-random-32-char-secret-key-1234"

# 3. SITE CONFIGURATION
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
SITE_NAME="KahaniNest"

# 4. INITIAL ADMIN CREDENTIALS (for prisma db:seed)
ADMIN_EMAIL="admin@storynest.internal"
ADMIN_PASSWORD="SuperSecretAdminPassword123!"

# 5. EMAIL / RESEND (https://resend.com)
RESEND_API_KEY="re_sample_1234567890abcdef"
NOTIFY_EMAIL="notifications@storynest.internal"

# 6. AGE GATE ENFORCEMENT MODE
# Options: 'overlay' (default - SEO friendly crawler access) or 'redirect' (strict middleware redirect)
AGE_GATE_MODE="overlay"
