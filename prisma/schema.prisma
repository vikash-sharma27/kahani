datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  EDITOR
  ADMIN
}

enum StoryStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
  SPAM
}

enum ReportReason {
  UNDERAGE_OR_MINOR
  NON_CONSENSUAL
  COPYRIGHT_OR_DMCA
  HATE_SPEECH
  SPAM_OR_ABUSE
  OTHER
}

enum ReportPriority {
  NORMAL
  HIGH
}

enum ReportStatus {
  OPEN
  REVIEWED
  ACTIONED
  DISMISSED
}

enum AdPosition {
  HOME_TOP
  HOME_MIDDLE_1
  HOME_MIDDLE_2
  HOME_BOTTOM
  LIST_IN_FEED
  STORY_TOP
  STORY_MIDDLE_1
  STORY_MIDDLE_2
  STORY_BOTTOM
  STICKY_MOBILE
}

enum AgeConsentResult {
  ACCEPTED
  DENIED
}

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String          @unique
  passwordHash  String
  role          Role            @default(EDITOR)
  isBanned      Boolean         @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  accounts      Account[]
  sessions      Session[]
  revisions     StoryRevision[]
  auditLogs     AuditLog[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Category {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  description    String?  @db.Text
  seoTitle       String?
  seoDescription String?
  sortOrder      Int      @default(0)
  colour         String   // CSS colour token, e.g. "rose", "emerald", "amber"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  stories        Story[]
}

model Story {
  id                     String          @id @default(cuid())
  title                  String
  slug                   String          @unique
  excerpt                String          @db.Text
  content                String          @db.Text // Sanitized text/HTML, TEXT ONLY, NO image fields
  authorName             String
  status                 StoryStatus     @default(DRAFT)
  publishedAt            DateTime?
  scheduledAt            DateTime?
  categoryId             String
  category               Category        @relation(fields: [categoryId], references: [id])
  viewCount              Int             @default(0)
  likeCount              Int             @default(0)
  commentCount           Int             @default(0)
  readingTimeMin         Int             @default(1)
  adultContentConfirmed  Boolean         @default(false)
  seoTitle               String?
  seoDescription         String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  parts                  StoryPart[]
  revisions              StoryRevision[]
  comments               Comment[]
  bookmarks              Bookmark[]
  likes                  Like[]
  readingHistory         ReadingHistory[]
  reports                Report[]

  @@index([status, publishedAt(sort: Desc)])
  @@index([categoryId, status, publishedAt])
  @@index([slug])
}

model StoryPart {
  id         String   @id @default(cuid())
  storyId    String
  story      Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  partNumber Int
  title      String
  content    String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([storyId, partNumber])
}

model StoryRevision {
  id              String   @id @default(cuid())
  storyId         String
  story           Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  contentSnapshot String   @db.Text
  editorId        String
  editor          User     @relation(fields: [editorId], references: [id])
  createdAt       DateTime @default(now())
}

model StorySubmission {
  id                String           @id @default(cuid())
  name              String           // Pen name
  email             String
  title             String
  content           String           @db.Text
  requestedCategory String
  status            SubmissionStatus @default(PENDING)
  flagged           Boolean          @default(false)
  adminNote         String?          @db.Text
  ipHash            String
  deviceId          String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model Comment {
  id          String        @id @default(cuid())
  storyId     String
  story       Story         @relation(fields: [storyId], references: [id], onDelete: Cascade)
  deviceId    String
  displayName String
  parentId    String?
  parent      Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[]     @relation("CommentReplies")
  body        String        @db.Text
  status      CommentStatus @default(PENDING)
  ipHash      String
  createdAt   DateTime      @default(now())

  reports     Report[]

  @@index([storyId, status])
}

model Bookmark {
  id        String   @id @default(cuid())
  deviceId  String
  storyId   String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([deviceId, storyId])
  @@index([deviceId])
}

model Like {
  id        String   @id @default(cuid())
  deviceId  String
  storyId   String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([deviceId, storyId])
}

model ReadingHistory {
  id        String   @id @default(cuid())
  deviceId  String
  storyId   String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  lastPart  Int      @default(1)
  progress  Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([deviceId, storyId])
}

model Report {
  id         String         @id @default(cuid())
  storyId    String?
  story      Story?         @relation(fields: [storyId], references: [id], onDelete: SetNull)
  commentId  String?
  comment    Comment?       @relation(fields: [commentId], references: [id], onDelete: SetNull)
  storyUrl   String?
  reason     ReportReason
  details    String         @db.Text
  priority   ReportPriority @default(NORMAL)
  status     ReportStatus   @default(OPEN)
  createdAt  DateTime       @default(now())
}

model BlockedDevice {
  id        String   @id @default(cuid())
  identifier String  @unique // deviceIdHash or ipHash
  reason    String
  createdAt DateTime @default(now())
}

model Advertisement {
  id        String     @id @default(cuid())
  name      String
  position  AdPosition
  htmlCode  String     @db.Text
  enabled   Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model AgeConsentLog {
  id            String           @id @default(cuid())
  result        AgeConsentResult
  ipHash        String
  userAgentHash String
  createdAt     DateTime         @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model SeoSetting {
  id          String   @id @default(cuid())
  page        String   @unique
  title       String
  description String   @db.Text
  keywords    String?
  updatedAt   DateTime @updatedAt
}
